{
  "id": "tauric-governance-tools",
  "name": "Tauric governance and chat tools",
  "description": "Serve owner requests with fresh market data, research, governed paper and broker workflows, adjustable account policies and audited code workspaces. Tauric broker services enforce evidence, account bindings, policy, approval and release checks; direct live-source changes are unavailable.",
  "version": "0.6.0",
  "configSchema": {
    "type": "object",
    "required": [
      "platformUrl",
      "platformToken"
    ],
    "properties": {
      "platformUrl": {
        "type": "string"
      },
      "platformToken": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "tauric_paper_context",
      "tauric_review_context",
      "tauric_chat_context",
      "tauric_request_research",
      "tauric_research_status",
      "tauric_portfolio_action",
      "tauric_request_portfolio_research",
      "tauric_broker_review_context",
      "tauric_project_read",
      "tauric_project_action",
      "tauric_market_data"
    ]
  },
  "toolMetadata": {
    "tauric_paper_context": {
      "optional": true
    },
    "tauric_review_context": {
      "optional": true
    },
    "tauric_chat_context": {
      "optional": true
    },
    "tauric_request_research": {
      "optional": true
    },
    "tauric_research_status": {
      "optional": true
    },
    "tauric_portfolio_action": {
      "optional": true
    },
    "tauric_request_portfolio_research": {
      "optional": true
    },
    "tauric_broker_review_context": {
      "optional": true
    },
    "tauric_project_read": {
      "optional": true
    },
    "tauric_project_action": {
      "optional": true
    },
    "tauric_market_data": {
      "optional": true
    }
  }
}
