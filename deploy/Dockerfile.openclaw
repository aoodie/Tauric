FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY openclaw/package.json openclaw/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY scripts/patch_runtime_dependencies.mjs /patch_runtime_dependencies.mjs
RUN node /patch_runtime_dependencies.mjs /app \
    && rm -rf /usr/local/lib/node_modules/npm \
    && cp -a /app/node_modules/npm /usr/local/lib/node_modules/npm
COPY openclaw/plugin ./plugin
COPY openclaw/skills ./skills
COPY openclaw/workflows ./workflows
COPY openclaw/start.mjs openclaw/config.mjs openclaw/heartbeat-status.mjs ./
COPY backend/tauric/chat_instructions.txt ./chat_instructions.txt
RUN npm run plugin:build && npm run plugin:validate \
    && mkdir -p /state && chown -R node:node /app/plugin /state
ENV OPENCLAW_STATE_DIR=/state NODE_ENV=production
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=6 CMD node -e "fetch('http://127.0.0.1:18789/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "start.mjs"]
