FROM python:3.13-slim-bookworm@sha256:93498f36dc7e24ef233bfdf6cc17d4b8bd32d94ee737143e906460d5f5a914c5
ADD --checksum=sha256:32edb81a2b5eb7cd7c9d941b2bfbbb082fd2cd09e0e725930316af6b708db186 https://files.pythonhosted.org/packages/0a/e7/bb605a7bab2d8425a64b3fa762b39dc1bf1c7e3f11ba6fb5413d6db0ff8c/msgpack-1.2.3.tar.gz /tooling-inputs/msgpack-1.2.3.tar.gz
ADD --checksum=sha256:0cf3cae568d36aa9576b28dfb35f11328f1cb974ca7647d9475ebb86c75ac6e3 https://files.pythonhosted.org/packages/92/9d/c4e665119135114480843e7ab388fa94d8480650450e6f8e26b70d323a4c/urllib3-2.8.0-py3-none-any.whl /tooling-inputs/urllib3-2.8.0-py3-none-any.whl
COPY scripts/patch_python_tooling.py /patch_python_tooling.py
RUN python -I /patch_python_tooling.py && python -I -m pip --version && rm -rf /tooling-inputs
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LANGSMITH_TRACING=false
WORKDIR /app
COPY backend/requirements.runtime.lock ./requirements.runtime.lock
RUN sed -E '/^(pytest|ruff|iniconfig|pluggy|Pygments)==/d' requirements.runtime.lock > requirements.worker.lock \
    && pip install --no-cache-dir -r requirements.worker.lock \
    && useradd --create-home --uid 10001 tauric \
    && mkdir -p /runtime && chown tauric:tauric /runtime
ADD --checksum=sha256:cd50792b6a41ff0830cd9149a9a8fd2e27100799257dd7d2147534574db39299 https://codeload.github.com/TauricResearch/TradingAgents/tar.gz/8b22d43d01d9ddda5d686d093d5385884622f3de /tmp/upstream.tar.gz
RUN pip install --no-cache-dir --no-deps /tmp/upstream.tar.gz && rm /tmp/upstream.tar.gz
COPY backend/tauric ./tauric
ENTRYPOINT ["python", "-m", "tauric.container_start"]
CMD ["python", "-m", "tauric.worker"]
