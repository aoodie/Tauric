FROM python:3.13-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.lock ./requirements.lock
RUN sed -E '/^(pytest|ruff|iniconfig|pluggy|Pygments)==/d' requirements.lock > requirements.server.lock \
    && pip install --no-cache-dir -r requirements.server.lock \
    && useradd --create-home --uid 10001 tauric
COPY backend/tauric ./tauric
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini
COPY backend/tauric /app/project-source/backend/tauric
COPY backend/runners /app/project-source/backend/runners
COPY backend/tests /app/project-source/backend/tests
COPY frontend/src /app/project-source/frontend/src
COPY frontend/package.json /app/project-source/frontend/package.json
COPY openclaw/plugin/src /app/project-source/openclaw/plugin/src
COPY openclaw/config.mjs openclaw/package.json /app/project-source/openclaw/
COPY docs /app/project-source/docs
COPY README.md /app/project-source/README.md
ENTRYPOINT ["python", "-m", "tauric.container_start"]
EXPOSE 8000
CMD ["uvicorn", "tauric.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
