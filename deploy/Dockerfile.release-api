FROM python:3.13-slim-bookworm@sha256:93498f36dc7e24ef233bfdf6cc17d4b8bd32d94ee737143e906460d5f5a914c5
ADD --checksum=sha256:04c721c2c7448767e9e3f2520a475663d8ee0f09c31890f6d2bd70fd636a9647 https://files.pythonhosted.org/packages/31/f9/c0a1c127f9049db9155afc316952ea571720dd01833ff5e4d7e8e6352dbb/msgpack-1.2.1.tar.gz /tooling-inputs/msgpack-1.2.1.tar.gz
ADD --checksum=sha256:0cf3cae568d36aa9576b28dfb35f11328f1cb974ca7647d9475ebb86c75ac6e3 https://files.pythonhosted.org/packages/92/9d/c4e665119135114480843e7ab388fa94d8480650450e6f8e26b70d323a4c/urllib3-2.8.0-py3-none-any.whl /tooling-inputs/urllib3-2.8.0-py3-none-any.whl
COPY scripts/patch_python_tooling.py /patch_python_tooling.py
RUN python -I /patch_python_tooling.py && python -I -m pip --version && rm -rf /tooling-inputs
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.lock ./requirements.lock
RUN sed -E '/^(pytest|ruff|iniconfig|pluggy|Pygments)==/d' requirements.lock > requirements.server.lock \
    && pip install --no-cache-dir -r requirements.server.lock \
    && useradd --create-home --uid 10001 tauric
COPY backend/tauric ./tauric
COPY backend/runners ./runners
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini
COPY backend/tauric /app/project-source/backend/tauric
COPY backend/runners /app/project-source/backend/runners
COPY backend/tests /app/project-source/backend/tests
COPY frontend/src /app/project-source/frontend/src
COPY frontend/package.json /app/project-source/frontend/package.json
COPY openclaw/plugin/src /app/project-source/openclaw/plugin/src
COPY openclaw/config.mjs openclaw/package.json /app/project-source/openclaw/
COPY docs /app/project-source/docs
COPY README.md /app/project-source/README.md
ENTRYPOINT ["python", "-m", "tauric.container_start"]
EXPOSE 8000
CMD ["uvicorn", "tauric.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
